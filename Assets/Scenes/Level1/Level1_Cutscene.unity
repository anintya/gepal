  rakaDialogText: {fileID: 977918986}
  gepiDialogPanel: {fileID: 1491775447}
  gepiNameText: {fileID: 1100571161}
  gepiDialogText: {fileID: 360627074}
  charactersPerSecond: 35
  clickToRevealText: 1
  nextButton: {fileID: 972402902}
  nextButtonImage: {fileID: 972402903}
  nextButtonSprite: {fileID: 0}
  nextButtonLabel: {fileID: 0}
  normalButtonText: Lanjut
  finalButtonText: Mulai Materi
  rakaImage: {fileID: 1479078953}
  gepiImage: {fileID: 696960418}
  ekspresiAwalRaka: {fileID: -2562284749457044318, guid: 6e9401304849f61489dde2ac35a0ad07, type: 3}
  ekspresiAwalGepi: {fileID: 7735414953903893923, guid: 8e7f8d14ecb19ed4899c484dbcc5c8a9, type: 3}
  nextSceneName: Level1_Materi
  daftarDialog:
  - pembicara: 0
    isiDialog: Pagi yang cerah! Senang sekali bisa belajar di sekolah hari ini.
    ekspresiRaka: {fileID: -2562284749457044318, guid: 6e9401304849f61489dde2ac35a0ad07, type: 3}
    ekspresiGepi: {fileID: 7735414953903893923, guid: 8e7f8d14ecb19ed4899c484dbcc5c8a9, type: 3}
  - pembicara: 1
    isiDialog: Halo, Raka! Selamat pagi! Tapi, coba perhatikan halaman sekolah kita!
    ekspresiRaka: {fileID: -2562284749457044318, guid: 6e9401304849f61489dde2ac35a0ad07, type: 3}
    ekspresiGepi: {fileID: 7735414953903893923, guid: 8e7f8d14ecb19ed4899c484dbcc5c8a9, type: 3}
  - pembicara: 0
    isiDialog: Eh? Kenapa banyak sekali sampah berserakan di halaman sekolah?
    ekspresiRaka: {fileID: -8573973357372675969, guid: d6c86f453051f4e44a6e0df60552409b, type: 3}
    ekspresiGepi: {fileID: -3538344587573260330, guid: 3a51dbc38519d7b498152efaacb8f84f, type: 3}
  - pembicara: 1
    isiDialog: Sepertinya masih ada yang membuang sampah sembarangan. Lihat, ada
      botol plastik, bungkus makanan, dan sisa makanan.
    ekspresiRaka: {fileID: -8573973357372675969, guid: d6c86f453051f4e44a6e0df60552409b, type: 3}
    ekspresiGepi: {fileID: -126135998478375652, guid: 2afa6ba354e94c54bb886ef5b2725767, type: 3}
  - pembicara: 0
    isiDialog: Sayang sekali, ya. Padahal lingkungan sekolah seharusnya bersih dan
      nyaman untuk belajar.
    ekspresiRaka: {fileID: 6665056487053492498, guid: 44837e72f81f038439226ad0d40acc2f, type: 3}
    ekspresiGepi: {fileID: -126135998478375652, guid: 2afa6ba354e94c54bb886ef5b2725767, type: 3}
  - pembicara: 1
    isiDialog: Benar! Sampah yang dibuang sembarangan dapat mencemari lingkungan.
      Jika dibiarkan menumpuk, halaman sekolah bisa menjadi kotor dan bau.
    ekspresiRaka: {fileID: 6665056487053492498, guid: 44837e72f81f038439226ad0d40acc2f, type: 3}
    ekspresiGepi: {fileID: -3538344587573260330, guid: 3a51dbc38519d7b498152efaacb8f84f, type: 3}
  - pembicara: 0
    isiDialog: Kalau begitu, ayo kita bantu membersihkan halaman sekolah!
    ekspresiRaka: {fileID: 1019785943077022636, guid: c62d5dd30e810a04bb5509314e7d7bd5, type: 3}
    ekspresiGepi: {fileID: -3538344587573260330, guid: 3a51dbc38519d7b498152efaacb8f84f, type: 3}
  - pembicara: 1
    isiDialog: Setuju, Raka! Sebelum mulai, kita pelajari dulu cara membedakan sampah
      organik dan anorganik. Yuk, ikuti aku!
